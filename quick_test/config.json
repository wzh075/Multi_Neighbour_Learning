{
  "dataset": {
    "original_path": "/data1/Wuzhihe/Dataset/ModelNet40_Neighbour_view4_1.0",
    "small_dataset_path": "./data/small_dataset",
    "samples_per_class": 10,
    "num_views": 3,
    "num_images_per_view": 5
  },
  "training": {
    "epochs": 5,
    "batch_size": 4,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "save_model": true,
    "model_save_path": "./models/quick_model.pth"
  },
  "feature_extraction": {
    "batch_size": 4,
    "feature_dim": 128,
    "validate_features": true,
    "features_save_path": "./features/extracted_features.json"
  },
  "retrieval": {
    "topk_list": [1, 5, 10],
    "evaluate_object_retrieval": true,
    "evaluate_view_retrieval": false
  },
  "logging": {
    "log_dir": "./logs",
    "log_level": "INFO",
    "console_log": true,
    "file_log": true
  },
  "system": {
    "use_cuda": true,
    "num_workers": 2,
    "pin_memory": true,
    "seed": 42
  }
}